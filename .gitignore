# ── data / runtime ──────────────────────────────────────────────
# NOTE: bare `data/` matches at ANY depth, so it used to swallow the app's own
# source package `app/data/` (db.py + __init__.py) along with the runtime DB.
# That is why app/data/db.py was missing from the repo and main.py died with
# "No module named 'data'". Anchor the runtime dir to the repo root only.
/data/
!data/.gitkeep

*.db
*.db-shm
*.db-wal
*.sqlite3

# ── lead outputs (large, regenerable) ───────────────────────────
# keep leads_master.csv? it is ~1.7MB, useful to ship. Keep it.
# ignore the intermediate scratch files
leads.txt
leads_all.csv
leads_atlas.csv
leads_atlas.txt
leads_sites.csv
test_leads.txt
test_sites.csv
test_urls.txt

# ── run artefacts ───────────────────────────────────────────────
*.txt
!requirements.txt
!leads_independent.txt
!leads_master.txt
!leads_chains.txt
batch_report.csv
results.csv
bd_ok_*.html

# ── python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ── scratch scripts (start with _) ──────────────────────────────
_*.py

# ── secrets ─────────────────────────────────────────────────────
.env
*.env
!.env.example

# ── editors / os ────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# app runtime
app/outreach/blaster.db*
app/outreach/shots/
app/outreach/__pycache__/
app/**/__pycache__/
app/_*.py

# ── app/data is SOURCE, not runtime ─────────────────────────────
# Must come LAST: the rules above (`data/`, `_*.py`, `*.db`) all match inside
# app/data/ and gitignore is last-match-wins. Without these negations,
# app/data/__init__.py is killed by `_*.py` and app/data/db.py by `data/`,
# which is how the app shipped broken.
!app/data/
!app/data/*.py
app/data/*.db
app/data/*.db-shm
app/data/*.db-wal

