# Bright Data — Web Unlocker (captcha solver enabled on the zone)
# Get from https://brightdata.com dashboard. Zone must have CAPTCHA Solver ON.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker1

